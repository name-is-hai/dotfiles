window-decoration = none

font-family = JetBrainsMono Nerd Font
font-size = 12

background-blur = true
background-opacity = 0.95

window-padding-x = 8
window-padding-y = 8

cursor-style = "block"
shell-integration-features = no-cursor,ssh-env

custom-shader = shaders/cursor_warp.glsl

theme = meowsoot

window-height = 40
window-width = 130
